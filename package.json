{
  "name": "vetwise",
  "version": "0.1.0",
  "private": true,
  "description": "Vetwise — a household pet-safety MCP server that answers \"is this safe for my pet?\" with species- and weight-aware toxicosis math and cited veterinary sources.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/toxins.test.ts tests/demo-reset.test.ts",
    "smoke": "tsx tests/mcp-smoke.ts",
    "regress": "tsx tests/review-regressions.ts",
    "check": "npm run typecheck && npm test && npm run smoke && npm run regress"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
