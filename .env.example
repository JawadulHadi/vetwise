# Vetwise configuration. Copy to `.env`; every value has a working demo default.
# Load with: node --env-file=.env --import tsx src/index.ts

# --- HTTP ---
PORT=3000
HOST=127.0.0.1

# Public URL used when the simulator calls its own /mcp endpoint.
# Set this to your tunnel URL when demoing remotely.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Host header allow-list. REQUIRED when serving through a tunnel or reverse proxy:
# the MCP Express integration rejects unknown Host headers to prevent DNS rebinding.
# Example: ALLOWED_HOSTS=vetwise.example.com,abc123.ngrok-free.app
ALLOWED_HOSTS=

# Allowed browser origins for MCP requests. Leave empty to allow any origin.
ALLOWED_ORIGINS=

# --- Data ---
# One JSON file. Delete it to reset the demo household.
VETWISE_DATA=./data/db.json

# --- Demo clock ---
# Freeze "now" for reproducible recordings. "HH:MM" means today at that local time.
# An ISO timestamp is also accepted. Leave empty to use the real clock.
# The demo narrative starts at 21:40 — two medications still due.
DEMO_CLOCK=21:40

# --- Credentials ---
# Demo tokens. Replace before exposing this server to anything but localhost.
# Owner: read + log + write + notify. Sitter: read + log + notify.
OWNER_TOKEN=maya-owner-demo-token
SITTER_TOKEN=noah-sitter-demo-token

# --- Agent ---
# bedrock = Amazon Bedrock Converse tool loop (needs AWS credentials)
# scripted = deterministic demo planner (default when no credentials are found)
VETWISE_AGENT=scripted

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# --- Caregiver alerts ---
# When set, alert_caregiver POSTs { channel, to, body, from } here and records the
# delivery result in the outbox. Unset, alerts are queued in the outbox only.
CAREGIVER_WEBHOOK_URL=
